___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const log = require('logToConsole');
const injectScript = require('injectScript');
const createArgumentsQueue = require('createArgumentsQueue');
const callInWindow = require('callInWindow');
const addConsentListener = require('addConsentListener');
const isConsentGranted = require('isConsentGranted');
const getUrl = require('getUrl');
const makeString = require('makeString');
const encodeUri = require('encodeUri');

const enableDebug = data.debug;
const debugLog = function(msg) {
  if (enableDebug) log('RUMvision GTM - ' + msg);
};

const propertyId = makeString(data.propertyId);
const hostname = data.hostnameOverride ? makeString(data.hostnameOverride) : getUrl('host');
const scriptUrl = 'https://d5yoctgpv4cpx.cloudfront.net/' + encodeUri(propertyId) + '/v3-' + encodeUri(hostname) + '.js';

// Initialise the rumv() command queue. Calls made before the script loads
// are buffered into window.rumv.q and replayed once the script is ready.
// Commands only take effect when the "Enable rumv() get/set API"
// developer setting is on for the RUMvision domain.
createArgumentsQueue('rumv', 'rumv.q');
// Always call the current window.rumv: the queue stub before load, the
// real RUMvision function after (e.g. for later consent changes).
const rumv = function(command, arg) {
  callInWindow('rumv', command, arg);
};

// Optional: disable automatic submission so it can be triggered manually.
if (data.disableAuto) {
  rumv('config', { auto: false });
  debugLog('auto submit disabled');
}

// Custom dimensions, sent with the current pageview.
const dimensions = {};
let dimensionCount = 0;
(data.customDimensions || []).forEach(function(row) {
  if (!row.name || row.value === undefined || row.value === null || row.value === '') return;
  dimensions[row.name] = row.value;
  dimensionCount++;
});
if (dimensionCount > 0) {
  rumv('set', dimensions);
  debugLog('set ' + dimensionCount + ' custom dimension(s)');
}

// Storage and device information follow the same consent decision.
const applyConsent = function(granted) {
  const value = granted ? 1 : 0;
  rumv('config', { consent_storage: value, consent_device: value });
  debugLog('consent_storage and consent_device = ' + value);
};

let hasFired = false;
const fire = function() {
  if (hasFired) return;
  hasFired = true;
  debugLog('Loading ' + scriptUrl);
  injectScript(scriptUrl, function() {
    debugLog('Script loaded');
    data.gtmOnSuccess();
  }, function() {
    debugLog('Script failed to load');
    data.gtmOnFailure();
  }, 'rumvision-' + propertyId);
};

const consentMode = data.consentMode || 'wait';

if (consentMode === 'always' || consentMode === 'never') {
  applyConsent(consentMode === 'always');
  fire();
} else {
  // wait: load only once analytics_storage is granted.
  // auto: load now, storage off until analytics_storage is granted.
  const granted = isConsentGranted('analytics_storage');
  applyConsent(granted);
  if (granted || consentMode === 'auto') {
    fire();
  } else {
    debugLog('Waiting for analytics_storage consent');
  }
  // Follow later changes both ways: a withdrawal switches storage off,
  // which makes RUMvision delete the data it stored.
  addConsentListener('analytics_storage', function(consentType, isGranted) {
    applyConsent(isGranted);
    if (isGranted) fire();
  });
}


