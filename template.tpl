- name: Wait mode is the default and does not load while analytics_storage is denied
  code: |-
    const mockData = {
      propertyId: 'RUM-OD60Q204MQ'
    };

    mock('isConsentGranted', function(t) { return false; });
    let listenedType;
    mock('addConsentListener', function(type, callback) { listenedType = type; });

    runCode(mockData);

    assertApi('injectScript').wasNotCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
    assertThat(listenedType).isEqualTo('analytics_storage');
- name: Wait mode loads once when consent is granted later
  code: |-
    const mockData = {
      propertyId: 'RUM-OD60Q204MQ',
      consentMode: 'wait'
    };

    let injectCount = 0;
    mock('isConsentGranted', function(t) { return false; });
    mock('addConsentListener', function(type, callback) {
      callback(type, true);
      callback(type, true);
    });
    mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {
      injectCount++;
      onSuccess();
    });

    runCode(mockData);

    assertThat(injectCount).isEqualTo(1);
    assertApi('gtmOnSuccess').wasCalled();
- name: Wait mode loads immediately when analytics_storage is already granted
  code: |-
    const mockData = {
      propertyId: 'RUM-OD60Q204MQ',
      consentMode: 'wait'
    };

    const commands = [];
    mock('callInWindow', function(fn, a, b) { commands.push([a, b]); });
    mock('isConsentGranted', function(t) { return true; });
    mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {
      onSuccess();
    });

    runCode(mockData);

    const configCalls = commands.filter(function(c) { return c[0] === 'config'; });
    assertThat(configCalls[configCalls.length - 1]).isEqualTo(['config', { consent_storage: 1, consent_device: 1 }]);
    assertApi('gtmOnSuccess').wasCalled();
- name: Withdrawn consent switches storage and device info off
  code: |-
    const mockData = {
      propertyId: 'RUM-OD60Q204MQ',
      consentMode: 'auto'
    };

    const commands = [];
    mock('callInWindow', function(fn, a, b) { commands.push([a, b]); });
    mock('isConsentGranted', function(t) { return true; });
    mock('addConsentListener', function(type, callback) {
      callback(type, false);
    });
    mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {
      onSuccess();
    });

    runCode(mockData);

    assertThat(commands[commands.length - 1]).isEqualTo(['config', { consent_storage: 0, consent_device: 0 }]);
- name: Custom dimensions are sent with rumv set and empty values are skipped
  code: |-
    const mockData = {
      propertyId: 'RUM-OD60Q204MQ',
      consentMode: 'always',
      customDimensions: [
        { name: 'page_type', value: 'product' },
        { name: 'release', value: '2026.09.22' },
        { name: 'empty_one', value: '' }
      ]
    };

    const commands = [];
    mock('callInWindow', function(fn, a, b) { commands.push([a, b]); });
    mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {
      onSuccess();
    });

    runCode(mockData);

    const setCalls = commands.filter(function(c) { return c[0] === 'set'; });
    assertThat(setCalls.length).isEqualTo(1);
    assertThat(setCalls[0]).isEqualTo(['set', { page_type: 'product', release: '2026.09.22' }]);
    assertApi('gtmOnSuccess').wasCalled();
